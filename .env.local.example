# Isi setelah project Supabase dibuat (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya dipakai di server (Server Actions/Route Handlers) — JANGAN diexpose ke client.
# Dipakai untuk operasi yang butuh bypass RLS (mis. tidak ada, saat ini semua lewat RLS+auth user).
# SUPABASE_SERVICE_ROLE_KEY=

# Nama bucket Storage untuk bukti transaksi (buat manual di Supabase Dashboard > Storage,
# set public, atau sesuaikan lib/actions/upload.ts jika mau private + signed URL)
NEXT_PUBLIC_SUPABASE_BUKTI_BUCKET=bukti-transaksi
